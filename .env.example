# Copy to .env.local and fill in. For local dev, the Supabase values are printed
# by `supabase start` / `supabase status` (API URL + anon + service_role keys).

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Absolute site origin used to build auth email / OAuth redirect links.
# Must match a Supabase redirect allow-list entry (see supabase/config.toml).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# ── Google OAuth (optional — enables "Continue with Google") ─────────────────
# Create an OAuth client at https://console.cloud.google.com and add
# <NEXT_PUBLIC_SUPABASE_URL>/auth/v1/callback as an authorized redirect URI.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ── Cloudflare Turnstile (bot mitigation on signup + application submit) ─────
# Required in production (SEC-23) — without it those two forms fail closed.
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
