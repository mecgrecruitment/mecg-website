# SQLite file path for local dev. Swap the provider in prisma/schema.prisma
# and this URL to move to Postgres later.
DATABASE_URL="file:./dev.db"

# Used only to create the first owner account when the user table is empty.
ADMIN_PASSWORD="changeme"
OWNER_EMAIL="admin@mecg.local"

# Secret used to HMAC-sign user session cookies. Any long random string.
SESSION_SECRET="change-this-to-a-long-random-string"
