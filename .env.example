# Copy to .env.local and fill in. For local dev, the Supabase values are printed
# by `supabase start` / `supabase status` (API URL + anon + service_role keys).
# Keep this file in sync with scripts/check-env.mjs and src/lib/env.ts (requireEnv).
#
# Use 127.0.0.1 — not localhost. Mixing them breaks auth redirects / cookies.
# Validate anytime: npm run check:env
# Print seed logins: npm run seed:users

# ── Supabase (required) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Absolute site origin used to build auth email redirect links.
# Must match Supabase Auth → URL Configuration (Site URL + redirect allow-list).
# Local allow-list lives in supabase/config.toml (site_url / additional_redirect_urls).
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# ── Cloudflare Turnstile (pair: both on or both off) ─────────────────────────
# Optional locally. For production, enable both keys together (SEC-23 / EX-61).
# Half-configured (only one key) fails closed on signup + application submit.
# Both unset skips the check (forms still work; Supabase rate limits still apply).
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
