# MECG Recruitment Supabase project (ref: chrxtsohxazngabdcpzb).
# Keep the service-role key server-only.
#
# The NEXT_PUBLIC_MECG_*/MECG_SUPABASE_SERVICE_ROLE_KEY variants below take
# priority over the unprefixed ones when both are set. They exist because the
# Vercel project's unprefixed NEXT_PUBLIC_SUPABASE_URL etc. may point at a
# different Supabase project shared by other apps on the same Vercel team;
# the MECG-prefixed vars let this app target its own project without
# renaming or conflicting with whatever else reads the unprefixed names.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
NEXT_PUBLIC_MECG_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_MECG_SUPABASE_ANON_KEY="your-anon-key"
MECG_SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Clerk owns login, signup, email verification, recovery, and sessions. The
# issuer must exactly match the Clerk Frontend API issuer configured as a
# Supabase third-party auth provider.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your-key"
CLERK_SECRET_KEY="sk_test_your-key"
CLERK_WEBHOOK_SIGNING_SECRET="whsec_your-secret"
CLERK_ISSUER="https://your-instance.clerk.accounts.dev"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/apply"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/apply"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/apply"

# Resend, used for recruitment emails and the public contact form.
# Clerk sends signup verification and password-reset emails.
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="MECG Recruitment <recruitment@example.com>"
CONTACT_TO_EMAIL="mecg-board@umich.edu"

# Where replies to applicant email land. Falls back to CONTACT_TO_EMAIL.
# Use a shared address so replies do not depend on one board member's inbox.
RECRUITMENT_REPLY_TO="mecg-recruitment@umich.edu"

# Required for the scheduled prune-resumes cron route. Vercel Cron sends this
# as a bearer token; the route fails closed (503) with no value set.
CRON_SECRET="your-cron-secret"

# Optional. Overrides Host-header inference for QR check-in links on the
# admin events page; leave unset to infer from the incoming request.
BASE_URL="https://your-deployed-domain.example.com"
